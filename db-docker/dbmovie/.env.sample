# *** DB Server and data ***

# DB Version (default 18)
# DB_TAG=18

# DB Server port (default 5432)
# DB_PORT=5432

# DB Database name (default dbmovie)
# DB_NAME=dbmovie

# DB Database user (default umovie)
# DB_USER=umovie

# DB Server user password (default password)
# DB_PASSWORD=password

# Timezone
# DB_TZ=Europe/Paris


# ******* GUI DB CLIENT *****

# GUI Version (default 9.18)
# GUI_TAG=9.18

# GUI Web Port (default 8080)
# GUI_PORT=8080

# GUI user name (default admin@example.org)
#GUI_USER=admin@example.org

# GUI user password (default password)
#GUI_PASSWORD=password